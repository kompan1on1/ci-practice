<?xml version='1.0'?> 
<project name='userthing' default='build' basedir='.'>
    <property name='build' value='./build'/>
    <property name='test' value='./test'/> 
    <property name='src' value='./src'/> 
    <property name='version' value='1.1.1'/> 

    <target name='build'>
        <mkdir dir="${build}"/>
        <copy todir="${build}/src">
            <fileset dir='${src}'/>
        </copy>
        <copy todir='${build}/test'>
            <fileset dir='${test}'/>
        </copy>
    </target>
    <target name='clean'>
        <delete dir='${build}'/>
    </target>

    <!-- listing 21.2 -->
    <target name="test" depends="build">
        <exec executable="vendor/bin/phpunit" checkreturn="true" passthru="true">
            <arg value="build/test"/>
        </exec>
    </target>

    <!-- listing 21.3 -->
    <target name="doc" depends="build">
        <mkdir dir="reports/docs" />
        <exec executable="php" dir="${phing.dir}" passthru="true" checkreturn="true">
            <arg line="phpDocumentor.phar --directory=build/src --target=reports/docs --title=userthing" />
        </exec>
    </target>

    <!-- listing 21.5 -->
    <target name='sniff' depends='build'>
        <exec executable='vendor/bin/phpcs' passthru='true' dir='${phing.dir}'>
            <arg line='--report-checkstyle=reports/checkstyle.xml 
                       --standard=PSR12 build/src'/>
        </exec>
    </target>
</project>